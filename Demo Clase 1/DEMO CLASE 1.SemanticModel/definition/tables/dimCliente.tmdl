	partition dimCliente = m
		mode: import
		queryGroup: Dimensiones
		source =
				let
				    Origen = stg_Clientes,
				    TipoCambiado = Table.TransformColumnTypes(Origen, {{"FechaRegistro", type date}})
				in
				    TipoCambiado

