/// Base de datos de SQL Server
expression pBaseDatos = "CafeAndino" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: 7ffef687-bd5f-4733-848c-7bee1ccec964
	queryGroup: Parámetros

